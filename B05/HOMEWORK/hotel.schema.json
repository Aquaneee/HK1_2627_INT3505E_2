{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/hotel.schema.json",
    "title": "Hotel",
    "description": "JSON Schema định nghĩa thực thể Khách sạn (Hotel)",
    "type": "object",
    "required": [
      "hotel_id",
      "name",
      "address",
      "city",
      "phone"
    ],
    "properties": {
      "hotel_id": {
        "type": "integer",
        "minimum": 1,
        "description": "Mã định danh duy nhất của khách sạn"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 150,
        "description": "Tên khách sạn"
      },
      "address": {
        "type": "string",
        "minLength": 5,
        "maxLength": 255,
        "description": "Địa chỉ chi tiết của khách sạn"
      },
      "city": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100,
        "description": "Thành phố/Tỉnh"
      },
      "rating_avg": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 5.0,
        "default": 0.0,
        "description": "Điểm đánh giá trung bình"
      },
      "phone": {
        "type": "string",
        "pattern": "^[0-9]{10,11}$",
        "description": "Số điện thoại liên hệ (10-11 chữ số)"
      }
    },
    "additionalProperties": false
  }